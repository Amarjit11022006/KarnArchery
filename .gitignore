# ==============================================================================
# KarnArchery - Professional .gitignore
# Stack: HTML5, CSS3, Vanilla JS, Three.js, Vite, npm, Git, Capacitor, Android
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# 2. Production Builds & Outputs
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
*.local

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------------------------
# 4. Vite, Bundler & Package Manager Caches
# ------------------------------------------------------------------------------
.vite/
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# 5. Logs & Temporary Runtime Files
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tmp/
temp/
*.tmp

# ------------------------------------------------------------------------------
# 6. Test Coverage & Testing Artifacts
# ------------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/

# ------------------------------------------------------------------------------
# 7. IDE, Code Editors & Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Visual Studio Code & JetBrains
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------------------
# 8. Capacitor & Android Studio Build Artifacts
# Note: The 'android/' directory is tracked; only generated build artifacts,
# local machine configurations, and private signing keys are ignored.
# ------------------------------------------------------------------------------
# Gradle build outputs & cache
.gradle/
android/.gradle/
android/build/
android/app/build/
android/captures/
android/.idea/
android/*.iml
android/*/*.iml

# Local machine SDK & tool paths
android/local.properties
local.properties

# Android package binaries
*.apk
*.aab
android/app/release/
android/app/debug/

# Android Keystore & Secret Signing Keys
*.jks
*.keystore
release-key.properties
debug.keystore

# ------------------------------------------------------------------------------
# 9. Explicitly Tracked Project Files & Game Assets
# ------------------------------------------------------------------------------
!package.json
!package-lock.json
!vite.config.js
!capacitor.config.ts
!capacitor.config.json
!capacitor.config.js

# Ensure all 3D assets, textures, and sounds are tracked
!assets/
!public/
!src/
!styles/
!*.glb
!*.gltf
!*.png
!*.jpg
!*.jpeg
!*.webp
!*.svg
!*.mp3
!*.ogg
!*.wav

